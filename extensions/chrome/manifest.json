{
  "manifest_version": 3,
  "name": "PCS 對話轉移",
  "version": "0.2.3",
  "description": "選取 ChatGPT 對話，送到 Prompt Calculus Studio 或下載檔案。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_title": "儲存到 PCS"},
  "content_scripts": [{"matches":["https://chatgpt.com/*","https://chat.openai.com/*"],"js":["content.js"],"run_at":"document_idle"}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
